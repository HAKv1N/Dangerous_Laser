  m_Text: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435 \u0444\u0430\u043A\u0442\u044B:\n1.
    \u0420\u0430\u0437\u0440\u0430\u0431\u0443 16 \u043B\u0435\u0442\n2. \u0418\u0433\u0440\u0430
    \u0431\u044B\u043B\u0430 \u0441\u0434\u0435\u043B\u0430\u043D\u0430 \u0437\u0430
    20 \u0434\u043D\u0435\u0439\n3. \u042D\u0442\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
    \u043F\u0440\u043E\u0435\u043A\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0430\u0432\u0442\u043E\u0440 \u043D\u0435 \u0437\u0430\u0431\u0440\u043E\u0441\u0438\u043B\n4.
    \u0412\u043E \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438,
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A \u043C\u043D\u043E\u0433\u043E\u0433\u043E
    \u043D\u0435 \u0437\u043D\u0430\u043B \u0438 \u0438\u0437\u0443\u0447\u0430\u043B
    \u0432\u0441\u0451 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E,
    \u043D\u0435 \u0445\u0435\u0439\u0442\u0438\u0442\u0435, \u043F\u0436\n--->"
